{
  "name": "peapod-server",
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": "^24.14.0"
  },
  "private": true,
  "dependencies": {
    "chalk": "^5.6.2",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "mongodb": "^7.1.0",
    "pusher": "^5.3.2",
    "spotify-web-api-node": "^4.0.0",
    "twilio": "^5.12.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.2",
    "@types/spotify-web-api-node": "^5.0.11",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "lint-staged": "^16.2.7",
    "local-ssl-proxy": "^2.0.5",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf node_modules",
    "dev": "concurrently \"tsx --watch src/server.ts\" \"local-ssl-proxy --source 3443 --target 3001\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint src/",
    "prepare": "git config core.hooksPath .githooks",
    "start": "node --import tsx src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}